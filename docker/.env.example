# Phase 0 — pinned stack versions (copy to docker/.env and adjust)
#   cp docker/.env.example docker/.env
#
# docker/.env is gitignored. Put real tunnel URLs only in docker/.env (or DM them).

ES_VERSION=8.11.0
MCP_IMAGE=docker.elastic.co/mcp/elasticsearch:0.4.0
GEMMA_MODEL_TAG=gemma4:e4b

# ---------------------------------------------------------------------------
# Ollama URL (backend container → LLM)
# ---------------------------------------------------------------------------

# A) Same machine as Ollama (default — host has gemma4:e4b):
OLLAMA_URL=http://host.docker.internal:11434

# B) Remote shared Ollama (M1 / teammate without gemma4:e4b).
#    Uncomment and set the CURRENT Cloudflare quick-tunnel URL from the host:
# OLLAMA_URL=https://xxxx.trycloudflare.com
#
# Host must run:
#   cloudflared tunnel --url http://127.0.0.1:11434 --http-host-header localhost
#
# Friend checklist:
#   1. cp docker/.env.example docker/.env
#   2. Set OLLAMA_URL to the URL the host DMs you (no trailing slash)
#   3. curl -sS "$OLLAMA_URL/api/tags" | python3 -m json.tool   # need gemma4:e4b
#   4. ./scripts/dev-up.sh
#   5. curl -s http://localhost:8000/health | python3 -m json.tool
