# Phase 0 — pinned stack versions (copy to docker/.env and adjust if needed)
#   cp docker/.env.example docker/.env
ES_VERSION=8.11.0
MCP_IMAGE=docker.elastic.co/mcp/elasticsearch:0.4.0
GEMMA_MODEL_TAG=gemma4:e4b

# ---------------------------------------------------------------------------
# Ollama URL (backend container → LLM)
# ---------------------------------------------------------------------------
# Default: host Ollama on the same machine as Docker Desktop
OLLAMA_URL=http://host.docker.internal:11434

# Remote shared Ollama (e.g. teammate tunnel to a stronger Mac). Examples:
#   OLLAMA_URL=https://ollama-team.example.com
#   OLLAMA_URL=https://xxxx.trycloudflare.com
# Do NOT commit real tunnel URLs or tokens into git.
