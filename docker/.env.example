# Phase 0/1 — copy to docker/.env and adjust
#   cp docker/.env.example docker/.env
#
# docker/.env is gitignored. Never commit real Cloudflare tunnel URLs.

# ---------------------------------------------------------------------------
# Image pins
# ---------------------------------------------------------------------------
ES_VERSION=8.11.0
MCP_IMAGE=docker.elastic.co/mcp/elasticsearch:0.4.0
GEMMA_MODEL_TAG=gemma4:e4b

# ---------------------------------------------------------------------------
# Service URLs seen by the BACKEND CONTAINER
# (compose already injects these; override only if you know what you are doing)
# ---------------------------------------------------------------------------
# ELASTICSEARCH_URL=http://elasticsearch:9200
# MCP_SERVER_URL=http://mcp-server:8080

# ---------------------------------------------------------------------------
# Ollama URL (backend container → LLM)  *** Phase 1B critical ***
# ---------------------------------------------------------------------------

# A) Host machine that HAS gemma4:e4b (Mayank / GPU host) — DEFAULT:
OLLAMA_URL=http://host.docker.internal:11434

# B) Teammate without local model (Vinit / M1) — use host's Cloudflare URL:
# OLLAMA_URL=https://xxxx.trycloudflare.com
# Rules:
#   - https only, NO trailing slash
#   - host must run:
#       cloudflared tunnel --url http://127.0.0.1:11434 --http-host-header localhost
#   - URL changes every time host restarts cloudflared → update + recreate backend

# ---------------------------------------------------------------------------
# AFTER ANY CHANGE TO OLLAMA_URL (or other backend env):
# ---------------------------------------------------------------------------
# Updating docker/.env alone does NOT update a running container.
#
#   docker compose -f docker/docker-compose.yml --env-file docker/.env \
#     up -d --force-recreate backend
#
# Verify what the container actually sees:
#   docker compose -f docker/docker-compose.yml --env-file docker/.env \
#     exec backend printenv OLLAMA_URL
#
# Then:
#   curl -s http://localhost:8000/health | python3 -m json.tool
#   # ollama.status should be "connected" and models include gemma4:e4b

# ---------------------------------------------------------------------------
# Teammate quick path (remote Gemma)
# ---------------------------------------------------------------------------
#   1. cp docker/.env.example docker/.env
#   2. Set OLLAMA_URL to the URL Mayank DMs you
#   3. curl -sS "$OLLAMA_URL/api/tags" | python3 -m json.tool
#   4. ./scripts/dev-up.sh   # or compose up --build
#   5. force-recreate backend if you changed OLLAMA_URL after first up
#   6. ./scripts/verify-phase1b-platform.sh
#   7. ./scripts/seed-alerts.sh   # if alerts-security empty
